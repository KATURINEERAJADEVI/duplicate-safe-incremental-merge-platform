# Duplicate-Safe Incremental Merge Platform
# Example environment configuration

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=duplicate_safe_merge
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password

# Constructed SQLAlchemy URL
DATABASE_URL=mysql+pymysql://root:your_mysql_password@localhost:3306/duplicate_safe_merge

# Replace with your own randomly generated secret key
SECRET_KEY=replace_with_a_random_secret_key

APP_ENV=development
UPLOAD_DIR=./backend/app/data/uploads
PROCESSED_DIR=./backend/app/data/processed
QUARANTINE_DIR=./backend/app/data/quarantine
REPAIRED_DIR=./backend/app/data/repaired